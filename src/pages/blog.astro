---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const brandName = profile.brandName || 'Blog';
const blogSubtitle = profile.blogSubtitle || '';

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title={`Blog - ${brandName}`} description={blogSubtitle || "Articles and technical writings."}>
    <main class="w-full max-w-[840px] mx-auto px-6 py-8">
        <!-- Blog Posts List -->
        {posts.length > 0 ? (
            <section class="flex flex-col gap-6">
                {posts.map(post => (
                    <article class="flex flex-col gap-2 group border-b border-border-color pb-6 last:border-b-0">
                        <div class="flex items-center gap-3 text-xs text-neutral-500 font-mono">
                            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                        </div>
                        <h2 class="font-heading text-lg font-bold text-black group-hover:underline">
                            <a href={`/blog/${post.id}`}>{post.data.title}</a>
                        </h2>
                        {post.data.description && (
                            <p class="text-sm text-neutral-700 leading-relaxed max-w-[720px]">
                                {post.data.description}
                            </p>
                        )}
                        <a href={`/blog/${post.id}`} class="text-xs font-semibold text-black underline underline-offset-4 decoration-neutral-300 hover:decoration-black mt-1">
                            Read article &rarr;
                        </a>
                    </article>
                ))}
            </section>
        ) : (
            <section class="flex flex-col items-center justify-center border border-dashed border-border-color rounded py-16 px-6 bg-neutral-50 text-center">
                <div class="w-12 h-12 rounded-full bg-white border border-border-color flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-neutral-500" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125"></path>
                    </svg>
                </div>
                <h2 class="font-heading text-lg font-bold text-black mb-1">No Articles Yet</h2>
                <p class="text-sm text-neutral-600 max-w-[360px] leading-relaxed">
                    Writing is currently in progress. Check back soon for my first post!
                </p>
            </section>
        )}
    </main>
</Layout>
