---
import Layout from '../layouts/Layout.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
---

<Layout title={`Projects - ${profile.brandName}`} description="Personal, research, and engineering projects by Reymel Sardenia.">
    <main class="w-full max-w-[840px] mx-auto px-6 py-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
            {projects.map(project => (
                <article class="bg-white border border-border-color rounded p-5 flex flex-col transition-all duration-200 hover:border-black hover:shadow-sm">
                    <div class="flex justify-between items-start gap-3 mb-2">
                        <h2 class="font-heading text-base font-bold text-black">
                            {project.title}
                        </h2>
                        {project.codeUrl && (
                            <a href={project.codeUrl} class="text-neutral-500 hover:text-black transition-colors p-0.5" target="_blank" rel="noopener noreferrer" aria-label={`View code repository for ${project.title}`}>
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.479C19.138 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
                                </svg>
                            </a>
                        )}
                    </div>
                    <div class="font-mono text-xs text-neutral-500 mb-2">
                        {project.comment}
                    </div>
                    <p class="text-sm text-neutral-700 leading-relaxed mb-4 flex-grow">
                        {project.description}
                    </p>
                    <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
                        {project.tags.map(tag => (
                            <span class="px-2 py-0.5 text-xs font-mono rounded bg-neutral-100 text-neutral-700 border border-neutral-200">
                                {tag}
                            </span>
                        ))}
                    </div>
                </article>
            ))}
        </div>
    </main>
</Layout>
