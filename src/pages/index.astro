---
import Layout from '../layouts/Layout.astro';
import profile from '../data/profile.json';
---

<Layout title={profile.seoTitle} description={profile.seoDescription}>
    <main class="w-full max-w-[840px] mx-auto px-6 py-8">
        <!-- Bio / Summary -->
        <article class="text-[1.05rem] text-neutral-800 leading-relaxed flex flex-col gap-5" set:html={profile.bio}>
        </article>
    </main>
</Layout>
