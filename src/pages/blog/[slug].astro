---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import profile from '../../data/profile.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const brandName = profile.brandName || '';

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title={brandName ? `${post.data.title} - ${brandName}` : post.data.title} description={post.data.description || ""}>
    <main class="w-full max-w-[840px] mx-auto px-6 py-8">
        <!-- Back link -->
        <a href="/blog" class="inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-black transition-colors mb-6 font-mono">
            &larr; Back to articles
        </a>

        <!-- Post Header -->
        <header class="mb-8">
            <div class="flex items-center gap-3 text-xs text-neutral-500 font-mono mb-2">
                <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
            </div>
            <h1 class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight mb-3 text-black">
                {post.data.title}
            </h1>
            {post.data.description && (
                <p class="text-base text-neutral-600 leading-relaxed italic border-l-2 border-neutral-300 pl-4 py-1">
                    {post.data.description}
                </p>
            )}
        </header>

        <!-- Divider Line -->
        <hr class="border-t border-border-color my-8">

        <!-- Post Content -->
        <article class="prose max-w-none text-neutral-900 font-body leading-relaxed">
            <Content />
        </article>
    </main>
</Layout>
