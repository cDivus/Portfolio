---
import { Image } from 'astro:assets';
import avatarImage from '../assets/avatar.jpg';
import profile from '../data/profile.json';

const pathname = Astro.url.pathname;
const isAbout = pathname === '/' || pathname === '/index.html' || pathname === '';
const isProjects = pathname.startsWith('/projects');
const isBlog = pathname.startsWith('/blog');
---

<header class="w-full max-w-[840px] mx-auto px-6 pt-10 sm:pt-14 pb-0">
    <!-- Profile Card (Avatar + Name + Role + Socials) -->
    <div class="flex items-center gap-6 sm:gap-7 mb-8">
        <div class="relative flex-shrink-0" transition:persist="avatar">
            <Image 
                src={avatarImage} 
                alt={profile.name} 
                width={192} 
                height={192} 
                quality={90}
                loading="eager" 
                fetchpriority="high" 
                class="w-[84px] sm:w-[96px] h-[84px] sm:h-[96px] rounded-xl object-cover border border-neutral-300"
            />
        </div>
        <div class="flex flex-col gap-1.5">
            <h1 class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight text-black">
                {profile.name}
            </h1>
            <p class="text-sm sm:text-base text-neutral-500 font-medium">
                {profile.role}
            </p>
            <div class="flex gap-3.5 mt-1.5 items-center">
                {profile.email && (
                    <a href={`mailto:${profile.email}`} class="text-neutral-500 hover:text-black transition-colors" aria-label="Email" title="Email">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
                        </svg>
                    </a>
                )}
                {profile.github && (
                    <a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-black transition-colors" aria-label="GitHub" title="GitHub">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.479C19.138 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
                        </svg>
                    </a>
                )}
                {profile.linkedin && (
                    <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-black transition-colors" aria-label="LinkedIn" title="LinkedIn">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" />
                        </svg>
                    </a>
                )}
            </div>
        </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="flex justify-between items-center border-b border-border-color text-sm font-medium">
        <div class="flex gap-7">
            <a 
                href="/" 
                class={`pb-3 -mb-[1px] transition-colors ${isAbout ? 'text-black font-semibold border-b-2 border-black' : 'text-neutral-500 hover:text-black'}`}
            >
                About
            </a>
            <a 
                href="/projects" 
                class={`pb-3 -mb-[1px] transition-colors ${isProjects ? 'text-black font-semibold border-b-2 border-black' : 'text-neutral-500 hover:text-black'}`}
            >
                Projects
            </a>
            <a 
                href="/blog" 
                class={`pb-3 -mb-[1px] transition-colors ${isBlog ? 'text-black font-semibold border-b-2 border-black' : 'text-neutral-500 hover:text-black'}`}
            >
                Blog
            </a>
        </div>
        {profile.resume && (
            <a 
                href={profile.resume} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="pb-3 -mb-[1px] text-xs sm:text-sm font-mono text-neutral-500 hover:text-black transition-colors inline-flex items-center gap-1 font-medium"
            >
                View CV &nearr;
            </a>
        )}
    </nav>
</header>
